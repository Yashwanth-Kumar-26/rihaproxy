# RihaProxy Environment Variables

# =============================================================================
# SERVER
# =============================================================================

# Port to run the server on (default: 16324)
RihaProxy_PORT=16324

# Host to bind to (default: 0.0.0.0)
RihaProxy_HOST=0.0.0.0

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Required: Bearer token for gateway authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=your_auth_token_here

# Optional: Specific token for Claude Code / Anthropic SDK clients
ANTHROPIC_AUTH_TOKEN=

# =============================================================================
# PROVIDER API KEYS
# =============================================================================

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# NVIDIA NIM (https://org.nvidia.com/)
NVIDIA_API_KEY=

# LM Studio (http://localhost:1234) — no key needed for local
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_API_KEY=

# OpenCode (https://opencode.ai/)
OPENCODE_API_KEY=

# Google AI / Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# GitHub Models (https://github.com/settings/personal-access-tokens)
GITHUB_TOKEN=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Together AI (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# xAI Grok (https://console.x.ai/)
XAI_API_KEY=

# Mistral (https://console.mistral.ai/api-keys/)
MISTRAL_API_KEY=

# Perplexity (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=

# Fireworks AI (https://fireworks.ai/account/api-keys)
FIREWORKS_API_KEY=

# Voyage AI (https://dashboard.voyageai.com/)
VOYAGE_AI_API_KEY=

# Kimi / Moonshot (https://platform.moonshot.cn/console/api-keys)
KIMI_API_KEY=

# MiniMax (https://platform.minimaxi.com/user-center/basic-information/interface-key)
MINIMAX_API_KEY=

# Alibaba Cloud (https://bailian.console.aliyun.com/)
ALICODE_API_KEY=

# GLM / Zhipu AI (https://open.bigmodel.cn/usercenter/apikeys)
GLM_API_KEY=

# =============================================================================
# SEARCH & SCRAPER TOOLS
# =============================================================================

# Tavily (https://tavily.com/)
TAVILY_API_KEY=

# Exa (https://exa.ai/)
EXA_API_KEY=

# Serper (https://serper.dev/)
SERPER_API_KEY=

# Firecrawl (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=

# Jina AI (https://jina.ai/)
JINA_AI_API_KEY=

# Ruflo Orchestration (https://github.com/ruvnet/ruflo)
RUFLO_BASE_URL=http://localhost:3000
RUFLO_API_KEY=
RUFLO_PLUGINS=true
RUFLO_AUTO_TOOLS=true

# =============================================================================
# FALLBACK CONFIGURATION
# =============================================================================

# Default provider when no model specified
DEFAULT_BACKEND=openrouter

# Default model
DEFAULT_MODEL=openai/gpt-4o-mini

# Fallback chain (comma-separated, tried in order)
FALLBACK_CHAIN=openrouter,openai

# =============================================================================
# PERFORMANCE & LIMITS
# =============================================================================

# Max concurrent requests per provider
MAX_CONCURRENT_PER_PROVIDER=10

# Request timeout in seconds
REQUEST_TIMEOUT=120

# Max tokens in response
DEFAULT_MAX_TOKENS=8192

# =============================================================================
# STORAGE
# =============================================================================

# Directory for persistence (default: ~/.rihaproxy)
DATA_DIR=

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable request/response logging (WARNING: may log sensitive data)
LOG_REQUESTS=false

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Enable RTK token compression
ENABLE_RTK=true

# Enable Caveman mode (aggressive output compression)
ENABLE_CAVEMAN=false

# Proxy for outbound requests (e.g., http://proxy:8080)
HTTP_PROXY=
HTTPS_PROXY=

# Cloud sync URL (future feature)
CLOUD_SYNC_URL=
CLOUD_SYNC_TOKEN=
